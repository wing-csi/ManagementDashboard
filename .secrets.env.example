# Local collector tokens. Copy this file to `.secrets.env`, put your real
# tokens in that copy, and run scripts/collect-local.sh.
#
#   cp .secrets.env.example .secrets.env
#
# `.secrets.env` is gitignored and must stay that way — the script refuses to
# run if it ever stops being ignored, rather than letting a token reach a
# commit. This example file holds placeholders only and IS committed.
#
# Fine-grained token permissions the collector needs, per repository:
#   Contents        Read-only
#   Pull requests   Read-only
#   Issues          Read-only     <-- without this the Projects tab stays empty
#   Metadata        (added automatically)

# Default token: any repo in config.toml with no `token_env` of its own, and
# REQUIRED — collect_github.py exits immediately without it, before it even
# reads the config.
#
# Only have the csihk token? Put it in both variables. wing-csi/AIFlowTesting
# is public so any valid token reads it; Tony-Liu-1248/abci-crm is private and
# owned by someone else, so it will fail. Exclude it from the verdict with:
#
#   ./scripts/collect-local.sh --allow-missing Tony-Liu-1248/abci-crm
GH_METRICS_TOKEN=github_pat_replace_me

# Used by every csihk/* repo (config.toml: token_env = "CSI_GH_METRICS_TOKEN").
# Its Resource owner must be the csihk organization, not your personal account.
CSI_GH_METRICS_TOKEN=github_pat_replace_me
